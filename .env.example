VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated allowlist of Google emails permitted to sign in.
# Leave empty to allow any Google account.
VITE_ALLOWED_EMAILS=

# Public HTTPS address of the receipt-server on the home PC (Tailscale Funnel URL),
# e.g. https://home-pc.tail1234.ts.net — no trailing slash.
# Leave empty to hide the "Add from picture" button.
VITE_RECEIPT_API_URL=
