# Firebase project ID (Firebase Console → Project settings → General → Project ID).
# Used only to verify sign-in tokens; no service-account key is needed.
FIREBASE_PROJECT_ID=

# Comma-separated Google emails allowed to scan. Must not be empty.
# Use the same values as VITE_ALLOWED_EMAILS in the web app.
ALLOWED_EMAILS=

# Comma-separated browser origins allowed to call the server (no path, no trailing slash).
ALLOWED_ORIGINS=https://bojan-jovanoski.github.io,http://localhost:5173

# Local Ollama instance and the vision model to use.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct

# Port the server listens on (localhost only; Tailscale Funnel forwards to it).
PORT=8787
